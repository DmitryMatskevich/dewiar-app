#!/bin/bash
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
        user=$(id -nu "$uid" 2>/dev/null) || continue
        systemctl --machine="$user@.host" --user disable --now dewiar-core.service >/dev/null 2>&1 || true
    done
    pkill -f /opt/dewiar/ui/app.py >/dev/null 2>&1 || true
    pkill -f /opt/cortex/ui/app.py >/dev/null 2>&1 || true
fi
exit 0
