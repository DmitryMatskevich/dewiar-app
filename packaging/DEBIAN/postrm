#!/bin/bash
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # файлы пакета dpkg уже удалил — здесь только то, что создано при установке (venv, кэш)
    rm -rf /opt/dewiar   # вместе со скачанной при установке моделью
    rm -rf /var/cache/dewiar
fi
command -v update-mime-database >/dev/null && update-mime-database /usr/share/mime >/dev/null 2>&1 || true
command -v update-desktop-database >/dev/null && update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
# Личные данные (~/.config/dewiar, ~/.local/share/dewiar) не трогаем: персонажи и настройки переживут переустановку.
exit 0
