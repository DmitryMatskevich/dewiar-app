<?xml version="1.0" encoding="utf-8"?>
<!-- Значок «Записать» на рабочем столе (CaptureWidget), мозг Dewiar (стиль brain из entities.js, белый полупрозрачный, w_brain.png) на
     матово-чёрном без обводки (отзыв 17.10: «некрасивая… может в неё мозг… чёрный, обводку убрать»). Одно нажатие — Dewiar слушает и записывает мысль в «Идеи»
     или ставит напоминание. Разметка RemoteViews: только простые виды. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/w_bg"
    android:paddingLeft="16dp"
    android:paddingRight="18dp">
    <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:scaleType="fitCenter"
        android:src="@drawable/w_brain"
        android:contentDescription="Dewiar слушает"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Записать"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/w_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="идея или напоминание"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="11.5sp"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
