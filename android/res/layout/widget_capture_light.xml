<?xml version="1.0" encoding="utf-8"?>
<!-- Значок «Записать» для светлых тем (CaptureWidget.views выбирает по теме приложения, pref look_body): тот же значок,
     что widget_capture.xml, но мягкий светлый неоморфизм (w_bg_light), мозг и текст — чернильные (#24324a). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/w_bg_light"
    android:paddingLeft="16dp"
    android:paddingRight="18dp">
    <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:scaleType="fitCenter"
        android:src="@drawable/w_brain_ink"
        android:contentDescription="Dewiar слушает"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Записать"
            android:textColor="#FF24324A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/w_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="идея или напоминание"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#A324324A"
            android:textSize="11.5sp"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
