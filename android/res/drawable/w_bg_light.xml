<?xml version="1.0" encoding="utf-8"?>
<!-- Фон значка «Записать» для светлых тем (24.10, владелец: «сейчас Лира оформлена красиво в белом — можно ли так же
     красиво эту кнопку?»): неоморфизм темы «Небесный» — тень снизу справа (#b8c5d6), блик сверху слева (#f7fbff),
     сама кнопка — мягкий градиент цвета фона (#dbe5f1). RemoteViews тени не умеет — слои layer-list. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle"><corners android:radius="22dp"/><solid android:color="#99B8C5D6"/></shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle"><corners android:radius="22dp"/><solid android:color="#F2F7FBFF"/></shape>
    </item>
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp"/>
            <gradient android:angle="315" android:startColor="#FFE6EDF6" android:endColor="#FFD4DFEC"/>
        </shape>
    </item>
</layer-list>
